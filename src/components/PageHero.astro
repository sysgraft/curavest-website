---
import Breadcrumbs from './Breadcrumbs.astro';
import SchematicGraphic from './SchematicGraphic.astro';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  breadcrumbs?: Crumb[];
  size?: 'default' | 'compact';
  /** Render the brand schematic motif, faint, in the empty right-hand side
   *  of the hero. Every "default" size interior hero uses this — see
   *  home-hero's own, labelled instance of the same graphic on the
   *  homepage. Skipped on "compact" heroes (legal/form pages) — those are
   *  meant to be plain and get straight to the point. */
  graphic?: boolean;
  /** Mirror the graphic horizontally on this page — see SchematicGraphic's
   *  `flip` prop. Used to vary the motif across pages that sit next to
   *  each other in navigation, so it doesn't read as one repeated image. */
  graphicFlip?: boolean;
  /** Give a long headline (e.g. a named case study's) more measure than the
   *  default 22ch, so it doesn't stack to five lines at desktop width. */
  wideTitle?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  breadcrumbs,
  size = 'default',
  graphic = false,
  graphicFlip = false,
  wideTitle = false,
} = Astro.props;
---

<section
  class={`page-hero on-panel ${size === 'compact' ? 'page-hero-compact' : ''} ${wideTitle ? 'page-hero-wide' : ''}`}
>
  {
    graphic && (
      <div class="page-hero-graphic" aria-hidden="true">
        <SchematicGraphic labeled={false} flip={graphicFlip} />
      </div>
    )
  }
  <div class="container hero-content">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede hero-lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-7) var(--space-8);
  }

  .page-hero-compact {
    padding-block: var(--space-6) var(--space-7);
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .page-hero .eyebrow {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .page-hero h1 {
    max-width: 22ch;
  }

  .page-hero-wide h1 {
    max-width: 30ch;
  }

  .hero-lede {
    margin-top: var(--space-5);
    max-width: 56ch;
    font-size: var(--text-md);
  }

  /* Faint brand motif filling the empty right-hand side of an interior
     hero — ties every page back to the homepage's schematic without
     competing with the heading/lede for attention. */
  .page-hero-graphic {
    position: absolute;
    top: 50%;
    right: clamp(-4rem, -2vw, 1rem);
    z-index: 0;
    width: clamp(20rem, 28vw, 30rem);
    aspect-ratio: 1 / 1;
    transform: translateY(-50%);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 74.9375rem) {
    .page-hero-graphic {
      display: none;
    }
  }
</style>
