---
interface Props {
  variant?: 'ink' | 'paper';
}
const { variant = 'ink' } = Astro.props;
---

<a href="/" class={`logo-lockup logo-${variant}`} aria-label="Curavest — home">
  <svg class="logo-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <path d="M12 12 H62 L88 38 V88 H12 Z" class="logo-mark-body" />
    <path d="M62 12 L88 38" class="logo-mark-accent" />
  </svg>
  <span class="logo-word">Curavest</span>
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .logo-mark {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
  }

  .logo-mark-body {
    fill: var(--color-ink);
  }

  .logo-mark-accent {
    stroke: var(--color-petrol-bright);
    stroke-width: 5.5;
    stroke-linecap: square;
  }

  .logo-paper .logo-mark-body {
    fill: var(--color-paper);
  }

  .logo-word {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.28rem;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .logo-paper {
    color: var(--color-on-panel);
  }

  .logo-paper .logo-word {
    color: var(--color-on-panel);
  }
</style>
