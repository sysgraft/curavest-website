---
interface Props {
  variant?: 'ink' | 'paper';
}
const { variant = 'ink' } = Astro.props;
const src = variant === 'paper' ? '/brand/curavest-horizontal-white.svg' : '/brand/curavest-horizontal-color.svg';
---

<a href="/" class={`logo-lockup logo-${variant}`} aria-label="Curavest — home">
  <img class="logo-mark" src={src} width="3699" height="1200" alt="" />
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-mark {
    height: 1.9rem;
    width: auto;
    display: block;
  }
</style>
