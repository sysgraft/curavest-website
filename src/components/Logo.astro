---
interface Props {
  variant?: 'ink' | 'paper';
}
const { variant = 'ink' } = Astro.props;
const src = variant === 'paper' ? '/brand/curavest-horizontal-white.svg' : '/brand/curavest-horizontal-color.svg';
---

<a href="/" class={`logo-lockup logo-${variant}`} aria-label="Curavest — home">
  <img class="logo-mark" src={src} width="3699" height="1200" alt="" />
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-mark {
    /* Was a fixed 1.9rem (≈30px rendered) at every viewport, reading as
       undersized against the rest of the header at desktop widths — the
       wordmark now scales with the viewport, from the original mobile
       size up to a properly prominent desktop size. */
    height: clamp(1.9rem, 1.55rem + 1.3vw, 2.75rem);
    width: auto;
    display: block;
  }
</style>
