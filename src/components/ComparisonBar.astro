---
interface Props {
  label: string;
  fromLabel: string;
  fromValue: number;
  toLabel: string;
  toValue: number;
  unit?: string;
}

const { label, fromLabel, fromValue, toLabel, toValue, unit = '' } = Astro.props;
const max = Math.max(fromValue, toValue);
const fromPct = Math.max((fromValue / max) * 100, 4);
const toPct = Math.max((toValue / max) * 100, 4);
---

<div class="comparison-bar">
  <p class="comparison-label">{label}</p>
  <div class="comparison-row">
    <span class="comparison-row-label">{fromLabel}</span>
    <div class="comparison-track">
      <div class="comparison-fill comparison-fill-from" style={`width:${fromPct}%`}></div>
    </div>
    <span class="comparison-row-value">{fromValue}{unit}</span>
  </div>
  <div class="comparison-row">
    <span class="comparison-row-label">{toLabel}</span>
    <div class="comparison-track">
      <div class="comparison-fill comparison-fill-to" style={`width:${toPct}%`}></div>
    </div>
    <span class="comparison-row-value">{toValue}{unit}</span>
  </div>
</div>

<style>
  .comparison-bar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .comparison-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr 4.5rem;
    align-items: center;
    gap: var(--space-3);
  }

  .comparison-row-label {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .comparison-track {
    height: 0.6rem;
    background: var(--color-line);
  }

  .comparison-fill {
    height: 100%;
  }

  .comparison-fill-from {
    background: var(--color-ink-3);
  }

  .comparison-fill-to {
    background: var(--color-petrol);
  }

  .comparison-row-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: right;
  }
</style>
