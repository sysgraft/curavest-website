---
// At desktop widths (>=64rem) this renders as a bordered card in a grid
// (see the parent page's `.service-list { display: grid }` rule) so the
// small number of services on offer reads as a confident, scannable
// comparison rather than a wall of stacked text. Below that it drops back
// to a full-width dossier row (large index, hairline rule) — sharp
// corners throughout, no shadow-heavy "pricing card" treatment. Meant to
// sit inside a parent with class="service-list".
interface Props {
  index: string;
  title: string;
  description: string;
  points?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  external?: boolean;
  meta?: string;
  featured?: boolean;
}

const {
  index,
  title,
  description,
  points,
  ctaLabel,
  ctaHref,
  external = false,
  meta,
  featured = false,
} = Astro.props;
---

<article class={`service-row ${featured ? 'service-row-featured' : ''}`}>
  <p class="service-index">{index}</p>
  <div class="service-body">
    <h3>{title}</h3>
    <p class="service-desc">{description}</p>
    {
      points && points.length > 0 && (
        <ul class="service-points">
          {points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      )
    }
    {meta && <p class="service-meta">{meta}</p>}
    {
      ctaLabel && ctaHref && (
        <a
          href={ctaHref}
          class="service-cta text-link"
          {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {ctaLabel} {external ? '↗' : '→'}
        </a>
      )
    }
  </div>
</article>

<style>
  .service-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-line);
  }

  .on-panel .service-row {
    border-color: var(--color-line-on-panel);
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-copper);
  }

  .service-row-featured .service-index {
    color: var(--color-petrol);
  }

  .service-body {
    max-width: 54rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ---- Desktop: card-in-a-grid instead of a stacked dossier row ----
     Activated by the parent page's `.service-list { display: grid }` at
     the same breakpoint — see index.astro / services/index.astro /
     about/index.astro. */
  @media (min-width: 64rem) {
    .service-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      height: 100%;
      padding: var(--space-6);
      border: 1px solid var(--color-line);
      border-top: 3px solid var(--color-ink);
      background: var(--color-paper);
    }

    .on-panel .service-row {
      border-color: var(--color-line-on-panel);
      border-top-color: var(--color-on-panel);
      background: var(--color-panel-raised);
    }

    .service-row-featured {
      border-top-color: var(--color-petrol);
    }

    .service-index {
      font-size: var(--text-md);
    }

    .service-body {
      max-width: none;
    }
  }

  .service-row-featured h3 {
    font-size: var(--text-xl);
  }

  .service-desc {
    color: var(--color-ink-2);
    line-height: var(--leading-relaxed);
    max-width: 58ch;
  }

  .service-points {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: var(--space-2);
  }

  .service-points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .service-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--color-petrol);
  }

  .service-meta {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    line-height: var(--leading-normal);
    max-width: 58ch;
  }

  .service-cta {
    margin-top: var(--space-2);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  @media (max-width: 34.375rem) {
    .service-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .service-index {
      font-size: var(--text-sm);
    }
  }
</style>
