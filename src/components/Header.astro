---
import Logo from './Logo.astro';
import { NAV, PRIMARY_CTA } from '../lib/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <Logo />

    <button
      type="button"
      class="menu-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="primary-nav-panel"
    >
      <span class="menu-toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <div id="primary-nav-panel" class="nav-panel" data-nav-panel>
      <nav aria-label="Primary">
        <ul class="nav-list">
          {
            NAV.map((item) => (
              <li class={`nav-item ${item.children ? 'has-children' : ''}`}>
                {item.children ? (
                  <>
                    <div class="nav-item-row">
                      <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                        {item.label}
                      </a>
                      <button
                        type="button"
                        class="nav-caret"
                        data-dropdown-toggle
                        aria-expanded="false"
                        aria-controls={`dropdown-${item.label.replace(/\s+/g, '-').toLowerCase()}`}
                      >
                        <svg width="11" height="7" viewBox="0 0 11 7" aria-hidden="true">
                          <path d="M1 1l4.5 4.5L10 1" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="visually-hidden">Show {item.label} pages</span>
                      </button>
                    </div>
                    <ul
                      id={`dropdown-${item.label.replace(/\s+/g, '-').toLowerCase()}`}
                      class="nav-dropdown"
                      data-dropdown
                    >
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="nav-dropdown-link"
                            aria-current={isActive(child.href) ? 'page' : undefined}
                            {...(child.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                          >
                            <span class="nav-dropdown-label">{child.label}</span>
                            {child.description && <span class="nav-dropdown-desc">{child.description}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a href={item.href} class="nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="nav-panel-cta">
        <a href={PRIMARY_CTA.href} class="btn btn-primary btn-sm">{PRIMARY_CTA.label}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 1.05rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .menu-toggle-bars,
  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: '';
    display: block;
    width: 1.4rem;
    height: 2px;
    background: var(--color-ink);
    position: relative;
    transition: transform var(--duration-base) var(--ease-standard), opacity var(--duration-base) var(--ease-standard);
  }

  .menu-toggle-bars::before {
    position: absolute;
    top: -0.45rem;
  }

  .menu-toggle-bars::after {
    position: absolute;
    top: 0.45rem;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-list {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-item-row {
    display: flex;
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.7rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink-2);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link[aria-current='page'] {
    color: var(--color-petrol);
  }

  .nav-caret {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--color-ink-2);
    border-radius: var(--radius-sm);
    margin-left: -0.35rem;
  }

  .nav-caret svg {
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .nav-caret[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    min-width: 320px;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop);
    padding: 0.6rem;
    display: none;
    flex-direction: column;
    gap: 0.15rem;
  }

  .nav-item.dropdown-open .nav-dropdown {
    display: flex;
  }

  .nav-dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-ink);
  }

  .nav-dropdown-link:hover {
    background: var(--color-paper);
  }

  .nav-dropdown-label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .nav-dropdown-desc {
    font-size: var(--text-xs);
    color: var(--color-ink-3);
  }

  .nav-panel-cta {
    flex-shrink: 0;
  }

  /* JS-enhanced state: collapse to a toggleable mobile panel.
     Without JS (.js-enhanced absent), everything stays visible/stacked —
     the site remains fully navigable. */
  @media (max-width: 63.9375rem) {
    /* Scoped to the mobile breakpoint: without this, the toggle button
       showed at every width once JS ran, sitting uselessly next to the
       full desktop nav (which this button doesn't control there). */
    :global(html.js-enhanced) .menu-toggle {
      display: inline-flex;
    }

    /* Fixed + inset:0 keeps the panel's box exactly at the viewport edges.
       Deliberately no transform here: a translateX used to slide this
       off-canvas also expanded the document's scrollable area on some
       mobile widths (fixed-position elements with a transform are
       included in the ancestor's scrollable overflow even when the
       transform pushes them fully off-screen). Visibility/opacity avoids
       that entirely while still giving a smooth open/close. */
    :global(html.js-enhanced) .nav-panel {
      position: fixed;
      inset: 0;
      top: 4.4rem;
      background: var(--color-paper);
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-5) var(--container-pad) var(--space-6);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transition: opacity var(--duration-base) var(--ease-standard), visibility 0s var(--duration-base);
    }

    :global(html.js-enhanced) .nav-panel[data-open='true'] {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--duration-base) var(--ease-standard), visibility 0s;
    }

    :global(html.js-enhanced) .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    :global(html.js-enhanced) .nav-item {
      flex-direction: column;
      align-items: stretch;
      border-bottom: 1px solid var(--color-line);
    }

    :global(html.js-enhanced) .nav-item-row {
      justify-content: space-between;
    }

    :global(html.js-enhanced) .nav-link {
      padding: 1rem 0.2rem;
      font-size: var(--text-md);
    }

    :global(html.js-enhanced) .nav-caret {
      width: 2.6rem;
      height: 2.6rem;
    }

    :global(html.js-enhanced) .nav-dropdown {
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0.75rem 0.2rem;
    }

    :global(html.js-enhanced) .nav-panel-cta {
      margin-top: var(--space-5);
    }

    :global(html.js-enhanced) .nav-panel-cta .btn {
      width: 100%;
    }
  }

  @media (min-width: 64rem) {
    .nav-panel {
      display: flex !important;
      position: static !important;
      visibility: visible !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  const html = document.documentElement;
  html.classList.add('js-enhanced');

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLDivElement>('[data-nav-panel]');

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('data-open', 'false');
    document.body.style.overflow = '';
  }

  function toggleMenu() {
    const isOpen = toggle?.getAttribute('aria-expanded') === 'true';
    toggle?.setAttribute('aria-expanded', String(!isOpen));
    panel?.setAttribute('data-open', String(!isOpen));
    document.body.style.overflow = !isOpen ? 'hidden' : '';
  }

  toggle?.addEventListener('click', toggleMenu);

  const mq = window.matchMedia('(min-width: 64rem)');
  mq.addEventListener('change', () => closeMenu());

  // Dropdown (Services) — click/keyboard toggle, not hover-dependent.
  document.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]').forEach((btn) => {
    const item = btn.closest('.nav-item');
    btn.addEventListener('click', () => {
      const isOpen = item?.classList.contains('dropdown-open');
      document.querySelectorAll('.nav-item.dropdown-open').forEach((el) => {
        el.classList.remove('dropdown-open');
        el.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item?.classList.add('dropdown-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    document.querySelectorAll('.nav-item.dropdown-open').forEach((el) => {
      if (!el.contains(event.target as Node)) {
        el.classList.remove('dropdown-open');
        el.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      document.querySelectorAll('.nav-item.dropdown-open').forEach((el) => {
        el.classList.remove('dropdown-open');
        el.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  // Close mobile panel when a link inside it is followed.
  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });
</script>
