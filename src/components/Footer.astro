---
import Logo from './Logo.astro';
import { SITE, FOOTER_LINKS } from '../lib/site';

const year = new Date().getFullYear();

const explore = FOOTER_LINKS.slice(0, 3);
const service = FOOTER_LINKS.slice(3, 7);
const more = FOOTER_LINKS.slice(7);
---

<footer class="site-footer on-panel">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="paper" />
      <p class="footer-statement">
        Curavest offers several complementary services for UK operational businesses, including fractional CTO
        support, AI Integration Services, and AI-integration products such as
        {' '}<a href={SITE.sysgraftUrl} class="text-link" target="_blank" rel="noopener noreferrer">Sysgraft</a>.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Explore">
      <h2 class="footer-heading">Explore</h2>
      <ul>
        {explore.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-nav" aria-label="Services">
      <h2 class="footer-heading">Services</h2>
      <ul>
        {service.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href={SITE.sysgraftUrl} target="_blank" rel="noopener noreferrer">Sysgraft &#8599;</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <h2 class="footer-heading">Contact</h2>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phoneLandline}`}>{SITE.phoneLandlineDisplay}</a></li>
        <li><a href={`tel:${SITE.phoneMobile}`}>{SITE.phoneMobileDisplay}</a></li>
      </ul>
      <a href="/start-a-conversation/" class="btn btn-outline btn-sm footer-cta">Start a Conversation</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
    <ul class="footer-legal">
      {more.filter((l) => l.label === 'Privacy Policy').map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-statement {
    max-width: 34ch;
    font-size: var(--text-sm);
    color: var(--color-on-panel-muted);
    line-height: var(--leading-relaxed);
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-on-panel-muted);
    margin-bottom: var(--space-4);
  }

  .footer-nav ul,
  .footer-contact ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-nav a,
  .footer-contact a {
    font-size: var(--text-sm);
    color: var(--color-on-panel);
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--color-petrol-bright);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
  }

  .footer-cta {
    margin-top: var(--space-5);
    align-self: flex-start;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line-on-panel);
    font-size: var(--text-xs);
    color: var(--color-on-panel-muted);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-5);
  }

  .footer-legal a {
    color: var(--color-on-panel-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-legal a:hover {
    color: var(--color-on-panel);
  }

  @media (max-width: 63.9375rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-6);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34.375rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
