---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { breadcrumbSchema, professionalServiceSchema, aiIntegrationServiceSchema } from '../../lib/schema';
import servicesBand from '../../assets/photography/services-band.jpg';

const title = 'Our Services | Curavest';
const description =
  'Explore Curavest services for UK operational businesses, including fractional CTO support and related offerings focused on process improvement and practical technology use.';

const starterQuestions = [
  'Our quoting process is too slow.',
  'Production cannot keep up with demand.',
  'We know we should be using technology better, but we are not sure where to start.',
  'We have grown, but the way we work has not kept pace.',
];
---

<BaseLayout
  title={title}
  description={description}
  path="/services/"
  jsonLd={[
    breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]),
    professionalServiceSchema(),
    aiIntegrationServiceSchema(),
  ]}
>
  <PageHero
    eyebrow="Curavest services"
    title="Complementary support for operational businesses"
    lede="Curavest offers several services designed to help UK businesses improve processes, output and technology decisions."
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]}
    graphic
  >
    <p class="lede hero-extra">
      Each service starts with the actual work: how it moves through people, systems and equipment, and where
      the real constraint sits.
    </p>
  </PageHero>

  <PhotoBand
    image={servicesBand}
    alt="A bright office hallway between glass-panel doors and partitions."
  />

  <section class="section">
    <div class="container">
      <div class="service-list">
        <ServiceCard
          featured
          index="01"
          title="Curavest – Fractional CTO Services"
          description="Part-time, embedded technology and process leadership for owners, MDs and boards."
          points={[
            'Diagnose operational and technology constraints.',
            'Redesign processes and decide where technology belongs.',
            'Oversee delivery until the improvement becomes normal practice.',
          ]}
          meta="Best suited to businesses with approximately £5m–£10m turnover in sectors such as manufacturing, construction supply, fire safety, tool and fixings supply, and outsourced product development."
          ctaLabel="Learn more about Fractional CTO Services"
          ctaHref="/services/fractional-cto/"
        />
        <ServiceCard
          index="02"
          title="Curavest – AI Integration Services"
          description="Understand where AI can genuinely improve an operational business, create a practical plan, then implement it — the same process-first approach as Fractional CTO Services."
          points={[
            'Understand which process AI would actually improve.',
            'Create a prioritised, practical implementation plan.',
            'Implement it and stay involved until it is normal practice.',
          ]}
          meta="Best suited to businesses with approximately £5m–£10m turnover in the same sectors as Fractional CTO Services — manufacturing, construction supply, fire safety, tool and fixings supply, and outsourced product development."
          ctaLabel="Learn more about AI Integration Services"
          ctaHref="/services/ai-integration/"
        />
        <ServiceCard
          index="03"
          title="Other Curavest services"
          description="Curavest is developing further services that complement Fractional CTO and AI Integration Services, focused on operational improvement."
          points={[
            'Further operational-improvement services, currently in development.',
            'More detail will appear here as they are finalised.',
            'In the meantime, an initial conversation can identify the best fit today.',
          ]}
          meta="If you are interested in discussing a specific problem now, we can use an initial conversation to identify which Curavest service is the best fit."
          ctaLabel="Start a conversation"
          ctaHref="/start-a-conversation/"
        />
        <ServiceCard
          index="04"
          title="Sysgraft (Curavest product)"
          description="Sysgraft is an AI-integration product for wholesale and distribution businesses, built by Curavest."
          meta="It helps these businesses use AI to review customer interactions, surface unmet needs and align their services more closely with what customers actually want."
          ctaLabel="Visit Sysgraft"
          ctaHref="https://sysgraft.com"
          external
        />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <h2>Not sure which service you need?</h2>
        <p class="lede">Most conversations begin with the problem, not the service name.</p>
      </div>

      <p class="starter-intro">Typical starting points include:</p>
      <div class="starter-grid">
        {
          starterQuestions.map((question) => (
            <blockquote class="starter-quote">&ldquo;{question}&rdquo;</blockquote>
          ))
        }
      </div>

      <p class="lede starter-outro">
        From there, we can identify whether the fractional CTO service, another Curavest offering or a
        combination is most appropriate.
      </p>

      <a href="/start-a-conversation/" class="btn btn-primary starter-cta">Talk through your situation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-extra {
    margin-top: var(--space-4);
  }

  .service-list {
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 64rem) {
    .service-list {
      /* Four cards in a 3-column grid orphaned the fourth onto its own
         row, alone on the left with empty space beside it. Two columns
         gives four cards two full, balanced rows — and more breathing
         room for the meta copy each card carries. */
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
      border-top: none;
      align-items: stretch;
    }
  }

  .section-heading {
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  .section-heading h2 {
    margin-top: var(--space-3);
  }

  .section-heading .lede {
    margin-top: var(--space-4);
  }

  .starter-intro {
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .starter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .starter-quote {
    margin: 0;
    padding: var(--space-5);
    background: var(--color-paper-raised);
    border-left: 3px solid var(--color-copper);
    font-size: var(--text-md);
    font-style: italic;
    color: var(--color-ink);
    line-height: var(--leading-relaxed);
  }

  .starter-outro {
    margin-top: var(--space-6);
    max-width: 56ch;
  }

  .starter-cta {
    margin-top: var(--space-6);
  }

  @media (max-width: 40rem) {
    .starter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
