---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectorIllustration from '../../../components/SectorIllustration.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { breadcrumbSchema } from '../../../lib/schema';

const title = 'Fractional CTO for Manufacturing and Operational Businesses | Curavest';
const description =
  'Curavest – Fractional CTO Services help ambitious UK manufacturers and operational businesses improve processes, output and technology decisions through part-time CTO support.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: 'Fractional CTO Services', path: '/services/fractional-cto/' },
  { name: 'Who I Work With', path: '/services/fractional-cto/who-i-work-with/' },
];

const rightFit = [
  'The business is established and commercially serious.',
  'Turnover is broadly in the £5m–£10m range.',
  'Growth is being limited by a process, bottleneck or capacity constraint.',
  'The owner or board wants a practical person to take responsibility.',
  'There is no full-time CTO, or hiring one would be premature.',
  'The business has capable people but not enough time or specialist judgement.',
  'Decisions can be made without prolonged internal politics.',
  'The leadership team is prepared to act on evidence.',
];

const wrongFit = [
  'Has no clear appetite for growth or improvement.',
  'Wants a software purchase without examining the process around it.',
  'Expects advice to replace leadership decisions.',
  'Is unwilling to involve the people doing the work.',
  'Has a culture of entrenched departmental conflict.',
  'Wants a one-off report with no implementation involvement.',
  'Needs a large permanent technology department immediately.',
];

const ownerRole = [
  'Explain what is creating pressure.',
  'Provide access to the people and processes involved.',
  'Be open to finding that the stated problem is not the real one.',
  'Make decisions when the evidence is clear.',
  'Support the people responsible for adopting the change.',
];

const sectors = [
  {
    icon: 'manufacturing',
    title: 'Manufacturing',
    body: 'Improve production flow, capacity, quality, reporting and the systems around the factory floor.',
  },
  {
    icon: 'construction',
    title: 'Construction supply',
    body: 'Reduce quote delays, improve product and service delivery, and identify opportunities hidden in how customers currently work.',
  },
  {
    icon: 'fire-safety',
    title: 'Fire safety',
    body: 'Strengthen the processes, information flow and customer delivery mechanisms that support a safety-critical service.',
  },
  {
    icon: 'tools-fixings',
    title: 'Tool and fixings supply',
    body: 'Improve quoting, fulfilment, customer responsiveness and the connection between commercial and operational teams.',
  },
  {
    icon: 'product-dev',
    title: 'Outsourced product development',
    body: 'Create better visibility and control across the relationship between the customer, the product and the delivery team.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/services/fractional-cto/who-i-work-with/"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Who I work with"
    title="For owners who need the business to move"
    lede="Curavest – Fractional CTO Services are designed for owners, MDs and boards of growing UK businesses where operational complexity is beginning to limit performance."
    breadcrumbs={crumbs}
  >
    <p class="lede hero-extra">
      The business may be successful already. The problem is that the way it works has not kept pace with its
      ambition.
    </p>
  </PageHero>

  <section class="section">
    <div class="container fit-section">
      <h2 class="statement statement-wide">A strong fit usually looks like this</h2>
      <ul class="check-list check-list-columns fit-list">
        {rightFit.map((item) => <li>{item}</li>)}
      </ul>
      <p class="lede fit-outro">This service suits businesses that want improvement to show up in the work itself.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-head">Experience closest to operational businesses</h2>
      <div class="sector-list">
        {
          sectors.map((sector) => (
            <div class="sector-row">
              <SectorIllustration name={sector.icon} class="sector-illustration" />
              <div>
                <h3>{sector.title}</h3>
                <p>{sector.body}</p>
              </div>
            </div>
          ))
        }
      </div>
      <p class="lede sector-note">
        The approach can apply beyond these sectors. The common factor is not the product. It is a business
        where work moves through people, processes, equipment and systems — and where a constraint in one part
        affects everything else.
      </p>
    </div>
  </section>

  <section class="section on-panel">
    <div class="container">
      <h2 class="section-head">Not every business needs this service</h2>
      <p class="lede wrong-fit-lead">
        Curavest – Fractional CTO Services are unlikely to be the right fit for a business that:
      </p>
      <ul class="check-list check-list-columns check-list-neg wrong-fit-list">
        {wrongFit.map((item) => <li>{item}</li>)}
      </ul>
      <p class="lede fit-outro">Being clear about fit protects everyone&rsquo;s time.</p>
    </div>
  </section>

  <section class="section">
    <div class="container fit-section">
      <h2 class="statement statement-wide">The work needs access and decisiveness</h2>
      <p class="lede owner-lead">The owner or board does not need to understand every technical detail. They do need to:</p>
      <ul class="check-list owner-list">
        {ownerRole.map((item) => <li>{item}</li>)}
      </ul>
      <p class="lede fit-outro">
        The best results come when leadership is available, direct and willing to let the facts change the
        plan.
      </p>
    </div>
  </section>

  <CtaBand
    title="Does this sound like your business?"
    lede="If your business is growing but the way it operates is becoming a constraint, start a conversation."
    ctaLabel="See if Fractional CTO Services are a fit"
    ctaHref="/start-a-conversation/"
    tone="ink"
  />
</BaseLayout>

<style>
  .hero-extra {
    margin-top: var(--space-4);
  }

  .fit-section {
    max-width: 50rem;
  }

  .fit-list,
  .owner-list {
    margin-top: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .owner-lead {
    margin-top: var(--space-4);
    font-weight: 600;
    color: var(--color-ink);
  }

  .fit-outro {
    max-width: 56ch;
  }

  .section-head {
    margin-bottom: var(--space-7);
    max-width: 36ch;
  }

  .wrong-fit-lead {
    max-width: 56ch;
    color: var(--color-on-panel-muted);
  }

  .wrong-fit-list {
    margin-top: var(--space-5);
    margin-bottom: var(--space-6);
  }

  /* "Wrong fit" list on a dark panel: a plain dash marker rather than
     the accent dot, so it reads distinctly from an affirmative list. */
  .check-list-neg li::before {
    content: '';
    width: 0.85rem;
    height: 1.5px;
    top: 0.75em;
    background: var(--color-on-panel-muted);
  }

  .sector-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }

  .sector-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }

  :global(.sector-illustration) {
    width: 4rem;
    height: 4rem;
    color: var(--color-ink-3);
    flex-shrink: 0;
  }

  .sector-row h3 {
    margin-bottom: var(--space-2);
  }

  .sector-row p {
    color: var(--color-ink-2);
    line-height: var(--leading-relaxed);
    max-width: 58ch;
  }

  @media (max-width: 30rem) {
    .sector-row {
      grid-template-columns: 3.25rem 1fr;
      gap: var(--space-4);
      align-items: start;
    }

    :global(.sector-illustration) {
      width: 2.75rem;
      height: 2.75rem;
      margin-top: 0.15rem;
    }
  }

  .sector-note {
    margin-top: var(--space-7);
    max-width: 62ch;
  }

</style>
