---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import SplitSection from '../../components/SplitSection.astro';
import {
  breadcrumbSchema,
  organizationSchema,
  personSchema,
  professionalServiceSchema,
  aiIntegrationServiceSchema,
} from '../../lib/schema';
import aboutBand from '../../assets/photography/about-band.jpg';
import euanPallister from '../../assets/photography/euan-pallister.jpg';

const title = 'About Curavest | Fractional CTO and Related Services';
const description =
  'Curavest offers several complementary services for UK operational businesses, including fractional CTO support and AI-integration products such as Sysgraft.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

const approach = [
  'Understand how work actually moves through the business.',
  'Identify where time, money or opportunity is being lost.',
  'Redesign the process and decide where technology belongs.',
  'Prove the change in real conditions, not just in theory.',
];

const ctoWork = [
  'Diagnosing operational and technology constraints.',
  'Redesigning processes.',
  'Deciding where technology and AI should be used.',
  'Overseeing delivery until the improvement becomes normal practice.',
];
---

<BaseLayout
  title={title}
  description={description}
  path="/about/"
  jsonLd={[
    breadcrumbSchema(crumbs),
    organizationSchema(),
    personSchema(),
    professionalServiceSchema(),
    aiIntegrationServiceSchema(),
  ]}
>
  <PageHero
    eyebrow="About Curavest"
    title="Practical support for growing operational businesses"
    lede="Curavest offers several complementary services to help UK operational businesses improve performance, make better technology decisions and use AI where it genuinely earns its place."
    breadcrumbs={crumbs}
    graphic
  >
    <p class="lede hero-extra">
      Our best-known service is <strong>Curavest – Fractional CTO Services</strong>, but the company&rsquo;s
      capabilities extend beyond this single offer.
    </p>
  </PageHero>

  <PhotoBand
    image={aboutBand}
    alt="A bright office hallway with framed artwork, leading to a workspace."
  />

  <section class="section">
    <div class="container">
      <SplitSection>
        <Fragment slot="visual">
          <div class="founder-photo">
            <Image
              src={euanPallister}
              alt="Euan Pallister, fractional CTO for UK operational businesses"
              width={640}
              height={640}
            />
            <p class="founder-caption">Euan Pallister — Fractional CTO, Curavest</p>
          </div>
        </Fragment>
        <h2 class="statement statement-wide">Start with the work, not the org chart</h2>
        <p class="lede approach-lead">Across all Curavest services, the approach is similar:</p>
        <ul class="check-list approach-list">
          {approach.map((item) => <li>{item}</li>)}
        </ul>
        <p class="lede approach-outro">
          This discipline comes from experience inside operational businesses: on factory floors, in
          customer-facing roles, running departments under pressure and building products and services from
          scratch.
        </p>
      </SplitSection>
    </div>
  </section>

  <section class="section on-panel">
    <div class="container">
      <h2 class="section-head">Part-time, embedded technology and process leadership</h2>
      <div class="cto-work-body">
        <p class="lede">
          Curavest – Fractional CTO Services provide owners, MDs and boards with senior technology and process
          judgement without requiring a full-time CTO appointment.
        </p>
        <p class="list-intro">The work includes:</p>
        <ul class="check-list cto-work-list">
          {ctoWork.map((item) => <li>{item}</li>)}
        </ul>
        <a href="/services/fractional-cto/" class="btn btn-outline approach-cta">Learn more about Fractional CTO Services</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-head">Complementary capabilities</h2>
      <div class="service-list">
        <ServiceCard
          index="01"
          title="Curavest – AI Integration Services"
          description="Understand where AI can genuinely improve an operational business, create a practical plan, then implement it — the same process-first approach as Fractional CTO Services."
          meta="Best suited to the same sectors and turnover band as Fractional CTO Services."
          ctaLabel="Learn more about AI Integration Services"
          ctaHref="/services/ai-integration/"
        />
        <ServiceCard
          index="02"
          title="Sysgraft"
          description="AI integration for wholesale and distribution. Sysgraft is an AI-integration product for wholesale and distribution businesses, built by Curavest."
          meta="It helps these businesses use AI to review customer interactions, surface unmet needs and align their services more closely with what customers actually want."
          ctaLabel="Visit Sysgraft"
          ctaHref="https://sysgraft.com"
          external
        />
      </div>
    </div>
  </section>

  <CtaBand
    title="Talk about your situation, not just a service name"
    lede="If you are unsure which Curavest service fits your needs, start with the problem you are trying to solve."
    ctaLabel="Start a conversation"
    ctaHref="/start-a-conversation/"
    tone="petrol"
  />
</BaseLayout>

<style>
  .hero-extra {
    margin-top: var(--space-4);
  }

  .approach-lead {
    margin-top: var(--space-5);
    font-weight: 600;
    color: var(--color-ink);
  }

  .founder-photo {
    max-width: 20rem;
    margin-inline: auto;
  }

  .founder-photo :global(img) {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .founder-caption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-3);
    text-align: center;
  }

  .approach-list {
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .approach-outro {
    max-width: 56ch;
  }

  .section-head {
    margin-bottom: var(--space-7);
    max-width: 36ch;
  }

  .cto-work-body {
    max-width: 56ch;
  }

  .list-intro {
    font-weight: 600;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    color: var(--color-on-panel) !important;
  }

  .cto-work-list {
    margin-bottom: var(--space-6);
  }

  .approach-cta {
    margin-top: var(--space-6);
  }

  .service-list {
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 64rem) {
    .service-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
      border-top: none;
      align-items: stretch;
    }
  }
</style>
