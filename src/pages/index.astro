---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchematicGraphic from '../components/SchematicGraphic.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatRow from '../components/StatRow.astro';
import CtaBand from '../components/CtaBand.astro';
import PhotoBand from '../components/PhotoBand.astro';
import SplitSection from '../components/SplitSection.astro';
import {
  organizationSchema,
  websiteSchema,
  professionalServiceSchema,
  aiIntegrationServiceSchema,
} from '../lib/schema';
import homeBand from '../assets/photography/home-band.jpg';
import homeDetailBand from '../assets/photography/home-detail-band.jpg';

const title = 'Curavest | Fractional CTO and Related Services for UK Businesses';
const description =
  'Curavest offers several complementary services for UK operational businesses. Explore our fractional CTO service and related offerings to improve processes and technology decisions.';

const fitPoints = [
  'Growth is being limited by internal constraints.',
  'Processes no longer match the size of the business.',
  'Technology decisions feel risky or unclear.',
  'There is too much work for the current team, but not enough to justify a full-time senior hire.',
];

const whyPoints = [
  'Work moves through people, processes, equipment and systems.',
  'A constraint in one area affects the whole business.',
  'Practical judgement is more valuable than a generic framework.',
];
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={[organizationSchema(), websiteSchema(), professionalServiceSchema(), aiIntegrationServiceSchema()]}
>
  <section class="home-hero on-panel">
    <div class="container home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">Fractional CTO &amp; operational advisory</p>
        <h1>Practical support for growing operational businesses</h1>
        <p class="lede">
          Curavest offers several complementary services to help UK businesses fix broken processes, improve
          output and make better technology decisions.
        </p>
        <div class="brief-panel home-hero-brief">
          <p class="lede">
            Our best-known service is <strong>Curavest – Fractional CTO Services</strong>: part-time, embedded
            technology and process leadership for businesses that have outgrown the way they currently work.
          </p>
        </div>
        <div class="home-hero-actions">
          <a href="/services/fractional-cto/" class="btn btn-primary">Explore Fractional CTO Services</a>
          <a href="/services/" class="btn btn-outline">View other Curavest services</a>
        </div>
      </div>
      <div class="home-hero-graphic" aria-hidden="true">
        <SchematicGraphic />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SplitSection visualStyle="bleed">
        <Fragment slot="visual"><SchematicGraphic labeled={false} onPaper /></Fragment>
        <h2 class="statement statement-wide">The point where growth outpaces the way you work</h2>
        <p class="lede fit-lead">Many operational businesses reach a point where:</p>
        <ul class="check-list fit-list">
          {fitPoints.map((point) => <li>{point}</li>)}
        </ul>
        <p class="lede fit-outro">
          Curavest provides experienced, practical support at that point — through fractional leadership,
          targeted projects and focused products.
        </p>
      </SplitSection>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-head">Complementary support, built around one problem at a time</h2>
      <div class="service-list">
        <ServiceCard
          featured
          index="01"
          title="Curavest – Fractional CTO Services"
          description="Part-time, embedded technology and process leadership for owners, MDs and boards."
          points={[
            'Diagnose where the business is losing time, money or opportunity.',
            'Redesign processes and decide where technology belongs.',
            'Oversee delivery until the improvement becomes normal practice.',
          ]}
          ctaLabel="Learn more about Fractional CTO Services"
          ctaHref="/services/fractional-cto/"
        />
        <ServiceCard
          index="02"
          title="Curavest – AI Integration Services"
          description="Understand where AI can genuinely improve an operational business, create a practical plan, then implement it."
          points={[
            'Understand which process AI would actually improve.',
            'Create a prioritised, practical implementation plan.',
            'Implement it and stay involved until it is normal practice.',
          ]}
          ctaLabel="Learn more about AI Integration Services"
          ctaHref="/services/ai-integration/"
        />
        <ServiceCard
          index="03"
          title="Other Curavest services"
          description="Curavest is developing further services that complement Fractional CTO and AI Integration Services, focused on operational improvement."
          points={[
            'Further operational-improvement services, currently in development.',
            "Explore Sysgraft — Curavest's AI-integration product for wholesale and distribution.",
            'Or start a conversation now about the problem you are trying to solve.',
          ]}
          meta="More detail on these services will appear here soon."
          ctaLabel="View Sysgraft"
          ctaHref="https://sysgraft.com"
          external
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SplitSection reverse>
        <Fragment slot="visual">
          <Image
            src={homeDetailBand}
            alt="A data reporting dashboard on a laptop screen, showing clicks, impressions and trend lines."
            widths={[400, 700, 900]}
            sizes="(max-width: 63.9375rem) 90vw, 40vw"
            loading="lazy"
          />
        </Fragment>
        <h2 class="statement statement-wide">Built for businesses where the detail matters</h2>
        <p class="lede why-lead">Curavest works with companies where:</p>
        <ul class="check-list why-list">
          {whyPoints.map((point) => <li>{point}</li>)}
        </ul>
        <p class="lede why-outro">
          Our approach starts with the actual work, not the org chart. That applies across all Curavest
          services.
        </p>
      </SplitSection>
    </div>
  </section>

  <PhotoBand
    image={homeBand}
    alt="An empty, light-filled room with white walls, columns and a black door."
  />

  <section class="section proof-section">
    <div class="container">
      <h2 class="section-head">From bottleneck to double the output</h2>
      <div class="proof-panel">
        <div class="proof-body">
          <p class="lede">
            In one business, an assembly department had become a constraint. By diagnosing the real bottleneck
            and changing the process, output was doubled within six months without additional investment.
          </p>
          <p class="lede">
            In another, production output was increased to more than 50% above the documented machine maximum,
            delivering a three-year programme in eighteen months at higher quality than expected.
          </p>
          <p class="lede">
            These results came from process change first, with technology used only where it made the new
            process work better.
          </p>
        </div>
        <div class="proof-stats">
          <StatRow
            stats={[
              { value: '2×', label: 'output within six months, no additional investment' },
              { value: '50%+', label: 'above the documented machine maximum' },
              { value: '18 mo', label: 'to deliver a three-year production programme' },
            ]}
          />
        </div>
      </div>
      <p class="proof-link"><a href="/track-record/" class="text-link">See the full track record →</a></p>
    </div>
  </section>

  <CtaBand
    title="Not sure which service fits your situation?"
    lede="Start with a conversation about the problem you are trying to solve. We can then identify whether the fractional CTO service, another Curavest offering or a combination is most appropriate."
    ctaLabel="Start a conversation"
    ctaHref="/start-a-conversation/"
    tone="petrol"
  />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-8) var(--space-9);
  }

  .home-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: var(--space-7);
    align-items: start;
  }

  .home-hero-copy .eyebrow {
    margin-bottom: var(--space-4);
  }

  .home-hero-copy h1 {
    font-size: var(--text-5xl);
    max-width: 16ch;
  }

  .home-hero-copy .lede {
    margin-top: var(--space-5);
    max-width: 46ch;
    font-size: var(--text-md);
  }

  .home-hero-brief {
    margin-top: var(--space-5);
    max-width: 46ch;
  }

  .home-hero-brief .lede {
    margin-top: 0;
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Hero Banner component per guidelines: "CTA: White button with dark
     text (high contrast reverse)" — overrides the default blue primary
     button specifically within this dark, full-bleed hero context. */
  :global(.home-hero .btn-primary) {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--color-ink);
  }

  :global(.home-hero .btn-primary:hover) {
    background: var(--color-paper-raised);
    border-color: var(--color-paper-raised);
    box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.35);
  }

  .home-hero-graphic {
    aspect-ratio: 1 / 1;
    width: 90%;
    margin-inline: auto;
    margin-top: var(--space-7);
  }

  /* ---- Where Curavest fits / Why Curavest (each now paired with a
     visual via SplitSection, so the copy no longer needs its own
     max-width — SplitSection's grid column does that job) ---- */
  .fit-lead,
  .why-lead {
    margin-top: var(--space-5);
    font-weight: 600;
    color: var(--color-ink);
  }

  .fit-list,
  .why-list {
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .fit-outro,
  .why-outro {
    max-width: 52ch;
  }

  /* ---- Services / Proof: plain section heading ---- */
  .section-head {
    margin-bottom: var(--space-7);
    max-width: 32ch;
  }

  .service-list {
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 64rem) {
    .service-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      border-top: none;
      align-items: stretch;
    }
  }

  /* ---- Proof snapshot: bordered plate instead of a dark full-bleed band ---- */
  .proof-panel {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    padding: var(--space-7);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-ink);
  }

  .proof-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .proof-link {
    margin-top: var(--space-6);
  }

  .proof-stats :global(.stat-row) {
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (max-width: 63.9375rem) {
    .home-hero-inner {
      grid-template-columns: 1fr;
    }

    .home-hero-graphic {
      display: none;
    }

    .proof-panel {
      grid-template-columns: 1fr;
      padding: var(--space-6);
    }
  }
</style>
