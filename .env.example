# Runtime environment variables for the Worker's /api/contact handler
# (worker/index.ts). Set these in the Cloudflare dashboard — Workers & Pages
# → curavest-website → Settings → Variables and Secrets, under "Runtime"
# (not "Build") — not in a committed .env file. See README.md "Contact form
# setup" for full steps.

# Required — API key from https://resend.com (free tier available).
RESEND_API_KEY=

# Optional — destination inbox. Defaults to euan.pallister@curavest.co.uk.
CONTACT_TO_EMAIL=euan.pallister@curavest.co.uk

# Optional — verified sender on your Resend domain. Defaults to a Resend
# sandbox address that only works for testing, not real delivery.
CONTACT_FROM_EMAIL="Curavest Website <noreply@curavest.co.uk>"
