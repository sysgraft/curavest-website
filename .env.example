# The contact form's backend is a Supabase Edge Function
# (supabase/functions/curavest-contact-form/), not this Worker — it has no
# environment variables of its own to configure.
#
# The Edge Function's configuration lives in Supabase, not here, and is set
# as Edge Function secrets (Supabase dashboard → Project Settings → Edge
# Functions → curavest-contact-form → Secrets, or `supabase secrets set`).
# This file documents what those secrets are for reference — none of it is
# read from a local .env file. See README.md "Contact form setup" for full
# steps.

# Required — API key from https://resend.com (free tier available). Until
# this is set, the function still records every submission in Supabase, but
# honestly reports the form as unavailable instead of claiming a message
# was sent.
RESEND_API_KEY=

# Optional — destination inbox for the enquiry notification. Defaults to
# euan.pallister@curavest.co.uk.
CONTACT_TO_EMAIL=euan.pallister@curavest.co.uk

# Optional — verified sender on your Resend domain. Defaults to a Resend
# sandbox address that only works for testing, not real delivery.
CONTACT_FROM_EMAIL="Curavest <noreply@curavest.co.uk>"
